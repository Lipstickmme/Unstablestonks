# ---------------------------------------------------------------------------
# Prediction market (BigMarketV5)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# ---------------------------------------------------------------------------
# Wallet
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=40be7de0d2331dbad2baa537262e304c

# ---------------------------------------------------------------------------
# Networks
#
# NEXT_PUBLIC_DEFAULT_CHAIN: polygon | chiliz | base   (default: polygon)
# Set to `chiliz` to open the app on Chiliz Chain, where bets settle in WCHZ.
# NEXT_PUBLIC_SHOW_TESTNETS=true also offers Polygon Amoy and Chiliz Spicy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CHAIN=polygon
NEXT_PUBLIC_SHOW_TESTNETS=false

# ---------------------------------------------------------------------------
# Azuro sportsbook
#
# Every bet placed through this front end credits this address with GGR on the
# Azuro protocol. Set it to your own wallet or the revenue goes nowhere.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# RugRush (crash game)
# Set after running `npm run deploy:rugrush` in ../contracts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RUGRUSH_ADDRESS=

# ---------------------------------------------------------------------------
# Fiat on-ramp / off-ramp
#
# Publishable keys are NEXT_PUBLIC_*. Anything without that prefix is a secret
# and must never reach the browser — those are read only in app/api/ramp/*.
#
# A provider with no key configured is hidden from the wallet page rather than
# offered and then failing at the widget.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAMP_ENV=staging

NEXT_PUBLIC_TRANSAK_API_KEY=
TRANSAK_ACCESS_TOKEN=

NEXT_PUBLIC_MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_KEY=

NEXT_PUBLIC_MERCURYO_WIDGET_ID=
MERCURYO_SIGN_KEY=
